{
  "_ayuda": [
    "FUENTES DE SERIE: van dentro del .exe (se compilan con la app) y las ve todo el mundo.",
    "Rellena baseUrl, apiEndpoints y selectors de cada hueco (mismo formato que catalog-sources.example.json). Un hueco con baseUrl vacío no aparece en la app.",
    "El usuario puede añadir las suyas en %APPDATA%\\ejGames\\config\\catalog-sources.json; si usa el mismo id que una de aquí, la suya la sustituye.",
    "Si quieres que pasen por el relay, da de alta id → baseUrl en CATALOG_SOURCES de relay/wrangler.toml y redespliega."
  ],
  "sources": [
    {
      "id": "romshq",
      "name": "RomsHQ",
      "baseUrl": "https://romshq.com",
      "type": "scrape",
      "platforms": ["switch", "ps1", "ps2", "ps3", "ps4", "ps5", "xbox-360"],
      "apiEndpoints": {
        "search": "/search/{query}?page={page}",
        "popular": "/trending?page={page}",
        "newest": "/games?page={page}",
        "byPlatform": "/roms/{platformPath}?page={page}",
        "detail": "{id}"
      },
      "selectors": {
        "gameList": "div[class~='group/item']",
        "title": "h1, h3",
        "description": "p.leading-relaxed",
        "coverImage": "img[alt$=' cover']@src, img@src",
        "detailLink": "a@href",
        "downloadLink": "a[data-romshq-download]@data-video-id",
        "platform": "h1 + div > span:nth-child(2), span.text-emerald-400",
        "nextPage": "a[rel='next']@href"
      },
      "platformMapping": {
        "Switch": "switch",
        "PlayStation (PS1)": "ps1",
        "PS2": "ps2",
        "PS3": "ps3",
        "PS4": "ps4",
        "PS5": "ps5",
        "Xbox 360": "xbox-360"
      },
      "platformPaths": {
        "switch": "nintendo-switch",
        "ps1": "playstation-ps1",
        "ps2": "playstation-2",
        "ps3": "playstation-3",
        "ps4": "playstation-4",
        "ps5": "playstation-5",
        "xbox-360": "xbox-360"
      },
      "hideCategories": ["emulator"],
      "signedDownload": { "url": "/api/download/sign/{id}", "field": "download_url" },
      "imageHosts": ["romshq.com"],
      "rateLimitPerMinute": 30,
      "cacheMinutes": 30,
      "relay": "auto",
      "icon": null
    }
  ]
}
