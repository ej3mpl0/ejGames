{
  "_ayuda": [
    "FUENTES DE SERIE: van dentro del .exe (se compilan con la app) y las ve todo el mundo.",
    "Rellena baseUrl, apiEndpoints y selectors de cada hueco (mismo formato que catalog-sources.example.json). Un hueco con baseUrl vacío no aparece en la app.",
    "El usuario puede añadir las suyas en %APPDATA%\\ejGames\\config\\catalog-sources.json; si usa el mismo id que una de aquí, la suya la sustituye.",
    "Si quieres que pasen por el relay, da de alta id → baseUrl en CATALOG_SOURCES de relay/wrangler.toml y redespliega."
  ],
  "sources": [
    {
      "id": "nxbrew",
      "name": "NXBrew",
      "baseUrl": "https://nxbrew.net",
      "type": "scrape",
      "platforms": ["switch"],
      "apiEndpoints": {
        "search": "/?s={query}",
        "popular": "/switch-games/",
        "newest": "/latest/",
        "byPlatform": "/switch-games/{platformPath}",
        "detail": "{id}"
      },
      "selectors": {
        "gameList": "article.post",
        "title": "h2.entry-title a",
        "description": ".entry-content p:first-of-type",
        "coverImage": "img.wp-post-image@src, .post-thumbnail img@src",
        "detailLink": "h2.entry-title a@href",
        "downloadLink": ".entry-content a[href*='drive.google.com']@href, .entry-content a[href*='mega.nz']@href, .entry-content a[href*='1fichier']@href, .entry-content a[href*='mediafire']@href",
        "platform": ".cat-links a[href*='switch']",
        "region": ".entry-content strong:contains('Region') + *, .entry-content p:has(strong:contains('Region'))",
        "language": ".entry-content strong:contains('Language') + *, .entry-content p:has(strong:contains('Language'))",
        "size": ".entry-content strong:contains('Size') + *, .entry-content p:has(strong:contains('Size'))",
        "version": ".entry-content strong:contains('Update') + *, .entry-content p:has(strong:contains('Update'))",
        "breadcrumbs": ".breadcrumb",
        "screenshots": ".entry-content img@src",
        "nextPage": "a.next@href"
      },
      "platformMapping": {
        "Switch": "switch",
        "Nintendo Switch": "switch",
        "NSP": "switch",
        "XCI": "switch",
        "eShop": "switch"
      },
      "platformPaths": {
        "switch": "switch-games"
      },
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
      },
      "imageHosts": ["nxbrew.net"],
      "extractPasswords": ["nxbrew", "nxbrew.net"],
      "rateLimitPerMinute": 20,
      "cacheMinutes": 30,
      "relay": "auto",
      "icon": null
    },
