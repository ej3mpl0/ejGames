{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "ejGames",
  "description": "Your games, one tap away. A lightweight, fully customizable game launcher for Windows, and a guide to building themes.",
  "colors": {
    "primary": "#FF3A2D",
    "light": "#FF6A5C",
    "dark": "#FF3A2D"
  },
  "logo": {
    "light": "/images/logo-light.png",
    "dark": "/images/logo-dark.png"
  },
  "favicon": "/images/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "Geist",
    "heading": {
      "family": "Geist",
      "weight": 700
    }
  },
  "background": {
    "color": {
      "light": "#F5F2EE",
      "dark": "#141315"
    }
  },
  "thumbnails": {
    "preset": "classic",
    "appearance": "dark",
    "surface": "neutral"
  },
  "search": {
    "prompt": "Search the docs…"
  },
  "navbar": {
    "links": [
      { "type": "github", "href": "https://github.com/ej3mpl0/ejGames" }
    ],
    "primary": {
      "type": "button",
      "label": "Download",
      "href": "https://github.com/ej3mpl0/ejGames/releases/latest"
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "tabs": [
          {
            "tab": "Start",
            "groups": [
              { "group": "Start", "pages": ["index", "instalar", "funciones"] }
            ]
          },
          {
            "tab": "Build themes",
            "groups": [
              { "group": "Themes", "pages": ["temas"] },
              {
                "group": "Step by step",
                "pages": [
                  "guia/index",
                  "guia/carpeta",
                  "guia/theme-json",
                  "guia/primer-main",
                  "guia/rejilla",
                  "guia/mando",
                  "guia/ficha",
                  "guia/opciones",
                  "guia/sonidos-colores",
                  "guia/explorar",
                  "guia/depurar",
                  "guia/compartir"
                ]
              }
            ]
          },
          {
            "tab": "Reference",
            "groups": [
              { "group": "Manifest", "pages": ["referencia/theme-json"] },
              {
                "group": "SDK",
                "pages": [
                  "referencia/sdk",
                  "referencia/biblioteca",
                  "referencia/juegos",
                  "referencia/logros",
                  "referencia/explorar",
                  "referencia/guias",
                  "referencia/trucos-mapas",
                  "referencia/perfil",
                  "referencia/homebrew",
                  "referencia/mando",
                  "referencia/host",
                  "referencia/temporada",
                  "referencia/partidas",
                  "referencia/idiomas"
                ]
              },
              {
                "group": "Kit and practices",
                "pages": ["referencia/kit", "referencia/limites", "referencia/rendimiento"]
              }
            ]
          },
          {
            "tab": "Development",
            "groups": [
              { "group": "Development", "pages": ["desarrollo/compilar", "desarrollo/arquitectura"] }
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/ej3mpl0/ejGames"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  }
}
