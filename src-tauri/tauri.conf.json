{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ejGames",
  "version": "0.7.3",
  "identifier": "com.ej.ejgames",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://ejg-media.localhost http://ejg-theme.localhost https://*.steamstatic.com https://images.igdb.com https://*.steamgriddb.com",
        "media-src": "'self' blob: http://ejg-media.localhost http://ejg-theme.localhost",
        "font-src": "'self' data:",
        "frame-src": "http://ejg-theme.localhost http://ejg-safe.localhost https://mapgenie.io",
        "connect-src": "ipc: http://ipc.localhost http://ejg-media.localhost http://ejg-theme.localhost http://ejg-safe.localhost",
        "object-src": "'none'",
        "base-uri": "'none'"
      },
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Game",
    "shortDescription": "Launcher de juegos personalizable",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../themes/": "themes/",
      "../sdk/": "sdk/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
