{
  "id": "retro",
  "name": "Retro",
  "version": "1.0.0",
  "author": "ejGames",
  "description": "Menú arcade con pantalla CRT, fuente pixel y sonidos de 8 bits",
  "sdk": 1,
  "entry": "index.html",
  "modes": ["tv", "desktop"],
  "palette": ["#0b0b1e", "#1a1a3a", "#ff3df2", "#35f2ff"],
  "host": { "accent": "#ff3df2", "surface": "#10102a", "radius": "2px", "font": "Consolas, \"Cascadia Mono\", monospace" },
  "sounds": { "preset": "retro" },
  "overlay": { "style": "retro" },
  "features": { "explore": true },
  "windowControls": "host",
  "settings": [
    { "key": "palette", "type": "select", "label": "Paleta", "default": "arcade", "options": [
      { "value": "arcade", "label": "Arcade (neón)" },
      { "value": "phosphor", "label": "Fósforo verde" },
      { "value": "amber", "label": "Ámbar" },
      { "value": "gameboy", "label": "Portátil de 4 tonos" },
      { "value": "c64", "label": "Ordenador de 8 bits" }
    ] },
    { "key": "scanlines", "type": "toggle", "label": "Líneas de barrido", "default": true },
    { "key": "scanlineStrength", "type": "range", "label": "Intensidad de las líneas", "min": 0, "max": 60, "unit": "%", "default": 28 },
    { "key": "curve", "type": "toggle", "label": "Pantalla curvada", "default": true },
    { "key": "flicker", "type": "toggle", "label": "Parpadeo de fósforo", "default": false },
    { "key": "pixelate", "type": "select", "label": "Carátulas pixeladas", "default": "medium", "options": [
      { "value": "off", "label": "No" },
      { "value": "low", "label": "Un poco" },
      { "value": "medium", "label": "Medio" },
      { "value": "high", "label": "Mucho" }
    ] },
    { "key": "uppercase", "type": "toggle", "label": "Nombres en mayúsculas", "default": true },
    { "key": "fontSize", "type": "range", "label": "Tamaño del texto", "min": 10, "max": 22, "unit": "px", "default": 14 }
  ]
}
